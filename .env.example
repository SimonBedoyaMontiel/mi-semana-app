# Copia este archivo como .env y rellena con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). La clave "publishable" / "anon" es pública por diseño:
# la seguridad la dan las políticas RLS de supabase/schema.sql.

# App de escritorio (proceso principal de Electron)
MAIN_VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
MAIN_VITE_SUPABASE_KEY=tu-clave-publishable

# Versión web / móvil
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=tu-clave-publishable
