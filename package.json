{
  "name": "mi-semana",
  "productName": "Mi Semana",
  "version": "1.0.0",
  "description": "Agenda de escritorio: calendario, horarios y seguimiento de hábitos y suplementos.",
  "author": "Mi Semana",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/make-icon.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dist": "npm run check && electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
